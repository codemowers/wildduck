{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG WILDDUCK_VERSION=(?<currentValue>\\S+)\\nARG WILDDUCK_COMMIT=(?<currentDigest>\\S+)"
      ]
    }
  ]
}
